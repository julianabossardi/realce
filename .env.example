# Realce - PoC 100% local. Nenhuma chave de API e necessaria - tudo roda
# no proprio computador (Postgres local via Docker, Ollama, sentence-
# transformers).

# Postgres local (docker-compose.yml)
DATABASE_URL=postgresql://realce:realce@localhost:5433/realce

# Ollama (LLM local para avaliacao por criterios)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Top-k padrao entre a busca hibrida/RRF e a avaliacao por criterio do LLM
# (app/routes/busca.py::LIMITE_PADRAO). Deixado comentado de proposito - o
# codigo ja tem um padrao (8) sem precisar desta variavel. Descomentar so
# como ajuste temporario (ex: reduzir latencia numa demo ao vivo) - decisao
# consciente, nao para virar permanente sem querer.
# DEMO_TOP_K=5
