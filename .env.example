# Realce - PoC 100% local. Nenhuma chave de API e necessaria - tudo roda
# no proprio computador (Postgres local via Docker, Ollama, sentence-
# transformers).

# Postgres local (docker-compose.yml)
DATABASE_URL=postgresql://realce:realce@localhost:5433/realce

# Ollama (LLM local para avaliacao por criterios)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
